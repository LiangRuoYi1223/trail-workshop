{
  "name": "chuanheng-terrain-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "generate": "node dist/src/cli.js",
    "demo:fixture": "npm run build && node dist/scripts/create-demo-fixture.js",
    "demo": "npm run build && node dist/src/cli.js --config fixtures/demo.json",
    "demo:stage2": "npm run build && node dist/src/cli.js --config fixtures/stage2.json",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:dev": "npm run desktop:build && node desktop/scripts/launch.mjs",
    "desktop:package": "npm run desktop:build && node desktop/scripts/package.mjs",
    "desktop:test": "node --test desktop/tests/*.test.mjs",
    "desktop:probe": "node node_modules/electron/cli.js desktop/scripts/runtime-probe-main.mjs"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "earcut": "3.0.2",
    "geotiff": "3.0.5",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "polygon-clipping": "0.15.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "saxes": "6.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/clipper-lib": "6.4.0",
    "@types/earcut": "3.0.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
